config MODULINO_LED_MATRIX
	bool "Arduino Modulino LED Matrix display"
	default y
	depends on DISPLAY && I2C
	depends on DT_HAS_ARDUINO_MODULINO_LED_MATRIX_ENABLED
	help
	  Drive a 12x8 Modulino LED Matrix running Arduino node_modulino_firmware
	  over I2C. Supports vertically tiled MONO01 and packed L_4 grayscale.
	  See samples/drivers/display/modulino_led_matrix/README.md for usage
	  and firmware protocol limitations.
