# SPDX-License-Identifier: Apache-2.0

choice BOOTLOADER
	default BOOTLOADER_MCUBOOT if $(BOARD) = "idea_mesh_tracker_c2"
endchoice

config MERGED_HEX_FILES
	default y if $(BOARD) = "idea_mesh_tracker_c2"

choice MCUBOOT_MODE
	default MCUBOOT_MODE_SINGLE_APP if "$(BOARD)/$(BOARD_QUALIFIERS)" = "idea_mesh_tracker_c2/nrf54l15/cpuapp"
endchoice

choice BOOT_SIGNATURE_TYPE
	default BOOT_SIGNATURE_TYPE_ED25519 if "$(BOARD)/$(BOARD_QUALIFIERS)" = "idea_mesh_tracker_c2/nrf54l15/cpuapp"
endchoice

# Never fall back to MCUboot's repository development key for the C2 product.
config BOOT_SIGNATURE_KEY_FILE
	default "" if "$(BOARD)/$(BOARD_QUALIFIERS)" = "idea_mesh_tracker_c2/nrf54l15/cpuapp"

config MESHBUS_C2_EXTERNAL_SIGNING
	bool "Prepare the C2 application for external signing"
	help
	  Embed the configured Ed25519 public key in MCUboot, but leave the
	  application unsigned for a separate protected signer.

source "$(ZEPHYR_BASE)/share/sysbuild/Kconfig"
