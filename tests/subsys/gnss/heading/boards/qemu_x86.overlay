/ {
	fake_imu: fake-imu {
		compatible = "fobe,compass-vector-sensor";
		status = "okay";
		role = "imu";
	};

	fake_magn: fake-magn {
		compatible = "fobe,compass-vector-sensor";
		status = "okay";
		role = "magnetometer";
	};

	fake_heading: fake-heading {
		compatible = "fobe,compass-heading-sensor";
		status = "okay";
	};

	compass: compass {
		compatible = "zephyr,compass-composite";
		status = "okay";
		accel-source = <&fake_imu>;
		gyro-source = <&fake_imu>;
		magn-source = <&fake_magn>;
		source-startup-delay-ms = <0>;
		source-idle-timeout-ms = <0>;
		calibration-sample-period-ms = <0>;
		gyro-fusion-alpha-milli = <980>;
		imu-rate-override-supported;
	};

	chosen {
		meshbus,compass = &compass;
		meshbus,gnss = &gnss;
	};

	gnss: gnss {
		compatible = "zephyr,gnss-emul";
		status = "okay";
	};
};
