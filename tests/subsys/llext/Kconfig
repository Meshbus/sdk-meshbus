mainmenu "Meshbus LLEXT contract tests"

source "Kconfig.zephyr"

config MBS_LLEXT_TEST_ADD_SYSTEM_HEAP
	bool "Add the test-only LLEXT system heap requirement"
	default n

config HEAP_MEM_POOL_ADD_SIZE_MBS_LLEXT_TEST
	int
	default 196608 if MBS_LLEXT_TEST_ADD_SYSTEM_HEAP
	default 0
	help
	  Test-only subsystem heap requirement used to verify that LLEXT admission
	  follows Zephyr's final K_HEAP_MEM_POOL_SIZE rather than only the base
	  CONFIG_HEAP_MEM_POOL_SIZE.
