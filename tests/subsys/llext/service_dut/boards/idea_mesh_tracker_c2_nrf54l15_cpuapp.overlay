/* Dedicated validation-device layout. See README.rst before flashing. */

/delete-node/ &storage_partition;

&slot1_partition {
	reg = <0x0c2000 0x0a2000>;
};

/* App-mode tests need ZUI types but do not exercise the physical display. */
&ssd1306 {
	status = "disabled";
};

&cpuapp_rram {
	partitions {
		storage_partition: partition@164000 {
			compatible = "zephyr,mapped-partition";
			label = "meshbus-llext-test-settings";
			reg = <0x164000 0x003000>;
		};

		extra_partition: partition@167000 {
			compatible = "zephyr,mapped-partition";
			label = "meshbus-llext-test-filesystem";
			reg = <0x167000 0x00c000>;
		};

		llext_test_stage_partition: partition@173000 {
			compatible = "zephyr,mapped-partition";
			label = "meshbus-llext-test-stage";
			reg = <0x173000 0x001000>;
		};

		product_storage_partition: partition@174000 {
			compatible = "zephyr,mapped-partition";
			label = "product-storage-preserved";
			reg = <0x174000 0x009000>;
		};
	};
};

/ {
	chosen {
		zephyr,display = &llext_dummy_display;
	};

	llext_dummy_display: llext-dummy-display {
		compatible = "zephyr,dummy-dc";
		width = <128>;
		height = <64>;
	};

	fstab: fstab {
		compatible = "zephyr,fstab";
		extra: extra {
			compatible = "zephyr,fstab,littlefs";
			automount;
			mount-point = "/extra";
			partition = <&extra_partition>;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <128>;
			lookahead-size = <16>;
			block-cycles = <128>;
		};
	};
};
