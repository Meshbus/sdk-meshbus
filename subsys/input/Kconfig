menuconfig MBS_INPUT
	bool "Meshbus input bridge"
	depends on INPUT
	default n
	help
      This option enables the Meshbus input bridge module.
      The input bridge module captures input events from
      various input devices (buttons, rotary encoders, keypads)
      and publishes them onto the Meshbus network via ZBUS.

if MBS_INPUT

module = MBS_INPUT
module-str = mbs_input
module-dep = MBS
module-help = Sets log level for Meshbus Input module
source "subsys/logging/Kconfig.template.log_config"

config MBS_INPUT_BUTTON
	bool "Enable button input (primary/secondary)"
	default y

config MBS_INPUT_BUTTON_MAX
	int "Maximum number of buttons to track"
	default 10
	depends on MBS_INPUT_BUTTON
	help
	  Maximum number of distinct button codes that can be tracked
	  simultaneously for gesture detection (short/long press).

config MBS_INPUT_ENCODER
	bool "Enable rotary encoder (scroll)"
	default y

config MBS_INPUT_KEYPAD
	bool "Enable keypad (e.g. IT8801)"
	default y

config MBS_INPUT_KEYPAD_MAX_KEYS
	int "Maximum number of keypad keys to track"
	default 16
	depends on MBS_INPUT_KEYPAD
	help
	  Maximum number of distinct keypad key codes that can be tracked
	  simultaneously for gesture detection (short/long press).

config MBS_INPUT_LONG_PRESS_MS
	int "Long press threshold (ms)"
	default 800
	depends on INPUT

config MBS_INPUT_REPEAT_DELAY_MS
	int "Directional key repeat start delay (ms)"
	default 350
	range 0 60000
	depends on INPUT
	help
	  Delay before held directional keys start publishing repeated short
	  actions. OK/BACK keys continue to use long-press detection.

config MBS_INPUT_REPEAT_INTERVAL_MS
	int "Directional key repeat interval (ms)"
	default 250
	range 1 60000
	depends on INPUT
	help
	  Interval between repeated short actions while a directional key remains
	  pressed. Set a positive value to keep navigation cadence predictable.

config MBS_INPUT_DEBOUNCE_MS
	int "Debounce time for key state changes (ms)"
	default 30
	depends on INPUT
	help
	  Debounce window applied to INPUT_EV_KEY state changes in Meshbus input
	  services (buttons and keypad). Events that toggle state within this
	  window are dropped. Set to 0 to disable.

config MBS_INPUT_ENCODER_STEP_THRESHOLD
	int "Encoder step aggregation threshold"
	default 1
	depends on INPUT

config MBS_INPUT_SHELL
	bool "Meshbus Input shell commands"
	depends on MBS_SHELL
	default y
	help
	  Enable shell commands for Meshbus Input subsystem.
	  Provides commands for basic diagnostics and event injection.

endif # MBS_INPUT
