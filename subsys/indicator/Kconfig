menuconfig MBS_INDICATOR
	bool "Meshbus Indicator Subsystem"
	default n
	help
	  Enable the Meshbus indicator subsystem which provides:
	  - Light indicator control (GPIO/PWM/LED strip)
	  - Buzzer audio feedback (PWM)
	  - Simple request model (new requests replace current)
	  - Configuration persistence via Settings

if MBS_INDICATOR

module = MBS_INDICATOR
module-str = mbs_indicator
module-dep = MBS
module-help = Sets log level for Meshbus Indicator module
source "subsys/logging/Kconfig.template.log_config"

config MBS_INDICATOR_LIGHT
	bool "Enable Light indicator"
	default y
	help
	  Enable Light indicator support. The Light device is selected via
	  devicetree chosen node "meshbus,indicator-light-active".

config MBS_INDICATOR_BUZZER
	bool "Enable buzzer indicator"
	default y
	depends on PWM
	help
	  Enable buzzer indicator support. The buzzer PWM device is selected
	  via devicetree chosen node "meshbus,indicator-buzzer".

config MBS_INDICATOR_BUZZER_RTTTL_MAX_NOTES
	int "Maximum notes in RTTTL melody"
	default 128
	range 16 256
	depends on MBS_INDICATOR_BUZZER
	help
	  Maximum number of notes that can be parsed from an RTTTL string.
	  Each note uses 4 bytes of static memory.

config MBS_INDICATOR_INPUT_FEEDBACK
	bool "Play buzzer feedback for input actions"
	default y
	depends on MBS_INPUT && MBS_INDICATOR_BUZZER
	help
	  Play short system tones when Meshbus input publishes short-press or
	  long-press actions. Encoder scroll actions use the short-press tone.
	  Raw press/release actions are ignored.

config MBS_INDICATOR_MESSAGE_FEEDBACK
	bool "Play buzzer feedback for received messages"
	default y
	depends on MBS_MESSAGE
	help
	  Play a short buzzer melody when Meshbus Message publishes an inbound
	  message response. The indicator buzzer configuration decides whether
	  direct and channel message alerts are allowed.

config MBS_INDICATOR_DEFAULT_LIGHT_HEARTBEAT
	bool "Enable light heartbeat feedback by default"
	default y
	help
	  Enable idle heartbeat light feedback by default.

config MBS_INDICATOR_DEFAULT_BUZZER_DIRECT_MESSAGE
	bool "Enable direct message buzzer feedback by default"
	default y
	help
	  Enable buzzer feedback for received direct messages by default.

config MBS_INDICATOR_DEFAULT_BUZZER_CHANNEL_MESSAGE
	bool "Enable channel message buzzer feedback by default"
	default y
	help
	  Enable buzzer feedback for received channel messages by default.

config MBS_INDICATOR_DEFAULT_BUZZER_SYSTEM
	bool "Enable system buzzer feedback by default"
	default y
	help
	  Enable buzzer feedback for system events by default.

config MBS_INDICATOR_LIGHT_IDLE_OFF_DURATION
	int "Default idle heartbeat off duration (ms)"
	default 4990
	range 1000 10000
	help
	  Duration of the Light off phase during idle heartbeat.
	  Total period = on_duration + off_duration.

config MBS_INDICATOR_LIGHT_IDLE_ON_DURATION
	int "Default idle heartbeat on duration (ms)"
	default 10
	range 10 500
	help
	  Duration of the Light on phase during idle heartbeat blink.

config MBS_INDICATOR_LIGHT_DEFAULT_RED
	int "Default Light red component (0-255)"
	default 0
	range 0 255
	help
	  Default red color component for Light indicator.

config MBS_INDICATOR_LIGHT_DEFAULT_GREEN
	int "Default Light green component (0-255)"
	default 0
	range 0 255
	help
	  Default green color component for Light indicator.

config MBS_INDICATOR_LIGHT_DEFAULT_BLUE
	int "Default Light blue component (0-255)"
	default 16
	range 0 255
	help
	  Default blue color component for Light indicator.

config MBS_INDICATOR_INIT_PRIORITY
	int "Indicator subsystem init priority"
	default 90
	help
	  Initialization priority for the indicator subsystem.

config MBS_INDICATOR_SHELL
	bool "Meshbus Indicator shell commands"
	depends on MBS_SHELL
	default y
	help
	  Enable shell commands for Meshbus Indicator subsystem.
	  Provides commands for testing Light and buzzer patterns.

endif # MBS_INDICATOR
