menuconfig MBS_CLOCK
	bool "Meshbus Clock Service"
	default n
	help
	  Enable Meshbus clock service.

	  This service provides runtime clock configuration persistence for
	  time format and UTC offset settings.

if MBS_CLOCK

module = MBS_CLOCK
module-str = mbs_clock
module-dep = MBS
module-help = Sets log level for Meshbus Clock service
source "subsys/logging/Kconfig.template.log_config"

config MBS_CLOCK_DEFAULT_TIME_FORMAT
	int "Default time format"
	range 0 1
	default 1
	help
	  Default clock time format.
	  0 = 12-hour format, 1 = 24-hour format.

config MBS_CLOCK_DEFAULT_UTC_OFFSET_MINUTES
	int "Default UTC offset (minutes)"
	range -720 840
	default 0
	help
	  Default UTC offset in minutes.

	  Runtime validation enforces:
	  - range -720..840 (UTC-12:00..UTC+14:00)
	  - multiples of 15 minutes only.

config MBS_CLOCK_INIT_PRIORITY
	int "Clock service init priority"
	default 90
	help
	  Initialization priority for the Meshbus Clock service.

config MBS_CLOCK_SHELL
	bool "Meshbus Clock shell commands"
	depends on MBS_SHELL
	default y
	help
	  Enable shell commands for Meshbus Clock service.

endif # MBS_CLOCK
