menuconfig MBS_RADIO
	bool "Meshbus Radio Management Layer"
	depends on LORA
	depends on LORA_MODULE_BACKEND_LORA_BASICS_MODEM
	select ZBUS_ASYNC_LISTENER
	default n
	help
	  Enable the Meshbus radio management layer.

if MBS_RADIO

module = MBS_RADIO
module-str = mbs_radio
module-dep = MBS
module-help = Sets log level for Meshbus Radio module
source "subsys/logging/Kconfig.template.log_config"

config MBS_RADIO_RECEIVE_POOL_SIZE
	int "RX message buffer pool size"
	default 4
	range 2 16
	help
	  Number of receive message buffers available for ZBus message
	  subscribers. Increase this value if the meshcore subsystem
	  cannot process messages fast enough and messages are lost.

	  NOTE: This option is not automatically wired to
	  CONFIG_ZBUS_MSG_SUBSCRIBER_NET_BUF_POOL_SIZE. Set that symbol
	  in your application Kconfig/prj.conf to adjust the actual pool size.

config MBS_RADIO_OPERATION_WORK_QUEUE_STACK_SIZE
	int "Radio operation workqueue stack size"
	default 1024
	range 512 4096
	help
	  Stack size of the shared Radio operation workqueue. Packet TX and
	  continuous-wave requests are serialized on this queue so potentially
	  blocking driver operations never block the system workqueue.

config MBS_RADIO_OPERATION_WORK_QUEUE_PRIORITY
	int "Radio operation workqueue priority"
	default 10
	help
	  Cooperative priority of the shared Radio operation workqueue.

config MBS_RADIO_DEFAULT_FREQUENCY
	int "Default frequency in Hz"
	default 915125000
	help
	  Default radio frequency in Hz.

config MBS_RADIO_DEFAULT_BANDWIDTH
	int "Default bandwidth in Hz"
	default 250000
	help
		Default radio bandwidth in Hz.

config MBS_RADIO_DEFAULT_SPREAD_FACTOR
	int "Default spreading factor"
	default 11
	range 5 12
	help
	  Default LoRa spreading factor (5-12).

config MBS_RADIO_DEFAULT_CODING_RATE
	int "Default coding rate"
	default 5
	range 5 8
	help
	  Default LoRa coding rate (5-8).

config MBS_RADIO_DEFAULT_PREAMBLE_LENGTH
	int "Default preamble length in symbols"
	default 16
	range 6 65535
	help
	  Default preamble length in symbols (6-65535).

config MBS_RADIO_DEFAULT_TX_POWER
	int "Default TX power in dBm"
	default 14
	range 0 22
	help
	  Default transmit power in dBm (0-22).

config MBS_RADIO_DEFAULT_ENABLED
	bool "Default radio enabled"
	default y
	help
	  Default radio enabled state at boot when no settings are stored.

config MBS_RADIO_DEFAULT_RECEIVE_ONLY
	bool "Default receive-only mode"
	default n
	help
	  Default receive-only mode at boot when no settings are stored.
	  When enabled, the device will not transmit any radio data.

config MBS_RADIO_DEFAULT_RX_BOOSTED
	bool "Default RX boosted mode"
	default y
	help
	  Default RX boosted mode at boot when no settings are stored.

config MBS_RADIO_DEFAULT_CRC
	bool "Default packet CRC enabled"
	default y
	help
	  Default packet CRC setting at boot when no settings are stored.

config MBS_RADIO_DEFAULT_DUTY_CYCLE
	bool "Default RX duty cycle enabled"
	default n
	help
	  Default RX duty cycle mode at boot when no settings are stored.

config MBS_RADIO_DEFAULT_DUTY_CYCLE_RX_TIME
	int "Default RX duty cycle active window (ms)"
	default 210
	range 1 262143
	help
	  Default active receive window in milliseconds for duty cycle mode.

config MBS_RADIO_DEFAULT_DUTY_CYCLE_SLEEP_TIME
	int "Default RX duty cycle sleep window (ms)"
	default 1790
	range 1 262143
	help
	  Default sleep window in milliseconds for duty cycle mode.

config MBS_RADIO_NOISE_FLOOR_SAMPLES
	int "Number of samples for noise floor calibration"
	default 16
	range 1 128
	help
	  Number of samples for noise floor calibration.

config MBS_RADIO_NOISE_FLOOR_SAMPLE_PERIOD_MS
	int "Noise floor calibration sample period (ms)"
	default 2000
	range 100 60000
	help
	  Period between successful RSSI samples while calibrating the
	  noise floor.

config MBS_RADIO_NOISE_FLOOR_SAMPLE_RETRY_MS
	int "Noise floor calibration retry period (ms)"
	default 2000
	range 100 60000
	help
	  Retry delay used when calibration cannot sample yet (radio not in RX,
	  device not ready, or RSSI read failure).


config MBS_RADIO_SHELL
	bool "Meshbus Radio shell commands"
	depends on MBS_SHELL
	default y
	help
	  Enable shell commands for Meshbus Radio subsystem.
	  Provides commands for radio configuration and diagnostics.

config MBS_RADIO_STATS
	bool "Meshbus Radio statistics"
	depends on MBS_STATS
	default y
	help
	  Enable statistics for Meshbus Radio subsystem.

endif # MBS_RADIO
