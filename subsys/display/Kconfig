menuconfig MBS_DISPLAY
	bool "Meshbus Display Service"
	depends on DISPLAY
	default n
	help
	  Enable Meshbus display service.

	  This service provides runtime display configuration, automatic sleep,
	  and display state publishing via ZBus.

if MBS_DISPLAY

module = MBS_DISPLAY
module-str = mbs_display
module-dep = MBS
module-help = Sets log level for Meshbus Display service
source "subsys/logging/Kconfig.template.log_config"

config MBS_DISPLAY_DEFAULT_BRIGHTNESS
	int "Default brightness"
	range 0 100
	default 100
	help
	  Default display brightness percentage (0-100).

config MBS_DISPLAY_DEFAULT_SLEEP_TIMEOUT
	int "Default sleep timeout (seconds)"
	range 0 300
	default 0
	help
	  Default display sleep timeout in seconds.
	  0 means automatic sleep is disabled.

config MBS_DISPLAY_DEFAULT_INVERT
	bool "Default invert"
	default n
	help
	  Default display invert setting.

config MBS_DISPLAY_INIT_PRIORITY
	int "Display service init priority"
	default 90
	help
	  Initialization priority for the Meshbus Display service.

config MBS_DISPLAY_DUMP_MAX_SIZE
	int "Maximum frozen display snapshot size in bytes"
	depends on U8G2_SNAPSHOT
	range 1 65536
	default 1024
	help
	  Storage for one shared snapshot used by chunked Display dump reads.
	  1024 bytes holds a 128x64 monochrome frame. Larger frames return
	  an error unless this limit is increased.

config MBS_DISPLAY_SHELL
	bool "Meshbus Display shell commands"
	depends on MBS_SHELL
	default y
	help
	  Enable shell commands for Meshbus Display service.

endif # MBS_DISPLAY
