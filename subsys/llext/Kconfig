menuconfig MBS_LLEXT
	bool "Meshbus LLEXT Extension Manager"
	depends on LLEXT && ZUI
	depends on FILE_SYSTEM
	select MBS_FS
	select LLEXT_HEAP_DYNAMIC
	default n
	help
	  Enable metadata inspection and loading of Desktop foreground apps
	  (.mba). Desktop owns execution; one app can be loaded at a time.

config MBS_LLEXT_BRIDGE
	bool "Meshbus LLEXT Bridge and exports"
	depends on LLEXT
	select LLEXT_EXPORT_DEVICES
	select LLEXT_EXPORT_DEV_IDS_BY_HASH
	select EVENTS
	select ZBUS_RUNTIME_OBSERVERS
	select ZBUS_PREFER_DYNAMIC_ALLOCATION
	default y
	help
	  Enable centralized Meshbus LLEXT bridge and EXPORT_SYMBOL tables.
	  This option keeps service LLEXT integration code in
	  subsys/llext while allowing it to be disabled
	  independently from the Desktop app loader.
	  Export host devicetree devices for native Zephyr driver APIs. Device
	  symbols use path hashes instead of dependency ordinals; this does not
	  replace the requirement to build against the target host's EDK.

if MBS_LLEXT

config MBS_LLEXT_LOG_LEVEL
	int "Log level for Meshbus LLEXT"
	default 3
	range 0 4
	help
	  Sets the log level for the Meshbus LLEXT extension manager.
	  0 = Off, 1 = Error, 2 = Warning, 3 = Info, 4 = Debug.

config MBS_LLEXT_APP_DEFAULT_PATH
	string "Default Desktop app extension path"
	default "/extra/apps"
	help
	  Default filesystem path where Desktop app extensions are stored.

config MBS_LLEXT_APP_MAX_HEAP_SIZE
	int "Maximum Desktop app LLEXT heap estimate"
	default 16384
	range 1024 1048576
	help
	  Maximum heap-size accepted from one Desktop app .mba metadata blob.
	  The value is generated by west meshbus llext and represents an estimate.

config MBS_LLEXT_APP_HEAP_RESERVE_SIZE
	int "Maximum dynamic LLEXT heap budget for one Desktop app"
	default 16384
	range 0 1048576
	help
	  Maximum dynamic LLEXT heap budget accepted for one foreground
	  Desktop app. The loader allocates this heap lazily when an
	  app is loaded; it is not reserved during firmware boot.

config MBS_LLEXT_APP_SYSTEM_HEAP_HEADROOM_SIZE
	int "System heap headroom beside a maximum Desktop app"
	default 4096
	range 0 1048576
	help
	  Minimum part of Zephyr's final system heap (K_HEAP_MEM_POOL_SIZE) that
	  must remain outside the maximum dynamic LLEXT heap allocation, including
	  its configured margin. The final size includes subsystem
	  HEAP_MEM_POOL_ADD_SIZE requirements as well as CONFIG_HEAP_MEM_POOL_SIZE.
	  This compile-time admission guard leaves room for allocator metadata and
	  concurrent system-heap users. It does not replace runtime heap-pressure
	  testing with the target app and services.

config MBS_LLEXT_DEFAULT_ENABLED
	bool "Default LLEXT app loading enabled"
	default y
	help
	  Default enable state for new app probe/load requests. Disabling the
	  loader does not interrupt an already loaded application.

config MBS_LLEXT_TOTAL_HEAP_MAX_SIZE
	int "Maximum total LLEXT heap reservation"
	default 131072
	range 1024 1048576
	help
	  Maximum dynamic LLEXT heap allocation for one app after adding
	  the configured margin to its heap-size estimate.

config MBS_LLEXT_DYNAMIC_HEAP_MARGIN_PERCENT
	int "Dynamic LLEXT heap margin percent"
	depends on LLEXT_HEAP_DYNAMIC
	default 5
	range 0 100
	help
	  Percent margin added to the heap-size value recorded in
	  app metadata before Meshbus allocates memory from the system
	  heap and initializes the Zephyr LLEXT heap.

config MBS_LLEXT_SHELL
	bool "Meshbus LLEXT shell commands"
	depends on MBS_SHELL
	default y
	help
	  Enable meshbus llext application configuration commands.

endif # MBS_LLEXT
