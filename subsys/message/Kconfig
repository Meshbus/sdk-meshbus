menuconfig MBS_MESSAGE
	bool "Meshbus message subsystem"
	depends on ZBUS
	default n
	help
	  Enable Meshbus message subsystem.

if MBS_MESSAGE
module = MBS_MESSAGE
module-str = mbs_message
module-help = Sets log level for Meshbus message management
source "subsys/logging/Kconfig.template.log_config"

config MBS_MESSAGE_MAX_STORE_COUNT
	int "Maximum number of messages"
	default 10
	range 5 45
	help
	  Maximum number of received messages that can be stored for
	  client-side reads. When the cache is full, the oldest received
	  message is dropped.

config MBS_MESSAGE_TX
	bool "Message send/command APIs"
	depends on MBS_CONTACT
	default y
	help
	  Enable outbound message command APIs and the command ZBus channel.

config MBS_MESSAGE_TX_MAX_LEN
	int "Maximum outbound message length"
	default 160
	range 1 160
	help
	  Maximum length of direct outbound text messages. ACK attempts above 3
	  require two extra protocol bytes and limit the payload to 158 bytes.
	  Channel messages also
	  carry a sender-name prefix, so their accepted payload length is reduced
	  by the current MeshCore node-name length plus two separator bytes.

config MBS_MESSAGE_PENDING_SEND_COUNT
	int "Maximum pending outbound ACK sends"
	default 8
	range 1 256
	help
	  Maximum number of outbound node messages that can wait for ACK
	  confirmation at the same time. The default matches MeshCore
	  companion_radio's expected ACK table size.

config MBS_MESSAGE_TX_TEST_ASSUME_RADIO_READY
	bool "Assume outbound radio is ready in tests"
	depends on ZTEST
	default n
	help
	  Test-only escape hatch for message TX unit tests that exercise the
	  request publishing path without compiling the full radio service.

config MBS_MESSAGE_SHELL
	bool "Message shell commands"
	depends on MBS_SHELL
	default y
	help
	  Enable shell commands for message management.
	  Provides commands for viewing/modifying local message
	  and message information.

endif # MBS_MESSAGE
