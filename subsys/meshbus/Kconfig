menuconfig MESHBUS
	bool "Meshbus support [EXPERIMENTAL]"
	select REBOOT
	select ENTROPY_GENERATOR
	select NANOPB
	select NANOPB_ENABLE_MALLOC
	select EXPERIMENTAL
	select ZBUS
	select ZBUS_MSG_SUBSCRIBER
	select SETTINGS
	help
	  This option enables Meshbus networking support.
	  Meshbus provides peer-to-peer mesh networking with
	  built-in encryption and multi-hop routing capabilities.

if MESHBUS

module = MESHBUS
module-str = meshbus
module-help = Sets log level for Meshbus support
source "subsys/logging/Kconfig.template.log_config"

config MESHBUS_SHELL
	bool "Meshbus shell commands"
	depends on SHELL
	default y
	help
	  Enable shell commands for Meshbus subsystem.
	  Provides commands for radio configuration, status monitoring,
	  and diagnostics under the 'meshbus' command group.

config MESHBUS_STATS
	bool "Meshbus statistics"
	select STATS
	select STATS_NAME
	default y
	help
	  Enable Meshbus statistics via Zephyr Stats subsystem.
	  Provides runtime statistics for Meshbus modules.

config MESHBUS_SETTINGS_PERSISTENCE_DELAY
    int "Meshbus settings persistence delay (ms)"
    default 500
    help
      Time in milliseconds to wait after a settings change before
      persisting to non-volatile storage. This helps to reduce
      write cycles by batching multiple changes. If delay is set to 0,
      settings will be persisted immediately after each change.

rsource "services/Kconfig"

endif # MESHBUS
