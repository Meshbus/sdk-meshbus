menuconfig MBS_BLUETOOTH
	bool "Meshbus Bluetooth Service (mcumgr over BLE)"
	default n
	depends on BT
	depends on BT_PERIPHERAL
	select BT_SMP
	select BT_SMP_SC_ONLY
	select BT_SMP_SC_PAIR_ONLY
	select BT_SMP_ENFORCE_MITM
	select BT_SETTINGS
	select BT_BONDABLE
	select BT_APP_PASSKEY
	select BT_DEVICE_NAME_DYNAMIC
	help
	  Enable Meshbus Bluetooth service.

	  This service manages secure BLE advertising and connection policy
	  for Meshbus Bluetooth features (for example MCUmgr SMP over BLE).

if MBS_BLUETOOTH

DT_CHOSEN_Z_DISPLAY := zephyr,display

module = MBS_BLUETOOTH
module-str = mbs_bluetooth
module-dep = MBS
module-help = Sets log level for Meshbus Bluetooth service
source "subsys/logging/Kconfig.template.log_config"

config MBS_BLUETOOTH_GATT_DIS
	bool "Enable Device Information Service (DIS)"
	default y
	select BT_DIS
	help
	  Enable Zephyr's standard Device Information Service (DIS).

config MBS_BLUETOOTH_GATT_BAS
	bool "Enable Battery Service (BAS)"
	default y
	select BT_BAS
	help
	  Enable Zephyr's standard Battery Service (BAS).

config MBS_BLUETOOTH_BATTERY_DEMO_LEVEL
	int "Battery demo level (0-100)"
	range 0 100
	default 50
	depends on MBS_BLUETOOTH_GATT_BAS
	help
	  Demo battery percentage reported by BAS. This is placeholder data
	  until the service is wired to real battery measurements.

config MBS_BLUETOOTH_GATT_TPS
	bool "Enable TX Power Service (TPS)"
	default y
	select BT_TPS
	help
	  Enable Zephyr's standard TX Power Service (TPS).

config MBS_BLUETOOTH_GATT_NOTIFY
	bool "Enable Meshbus notify GATT transport"
	default y
	depends on MBS_NOTIFY
	select ZBUS_RUNTIME_OBSERVERS
	help
	  Expose a vendor-specific GATT notify characteristic that forwards
	  Meshbus notify events as protobuf payloads.

config MBS_BLUETOOTH_INIT_PRIORITY
	int "Bluetooth service init priority"
	default 90
	help
	  Initialization priority for the Meshbus Bluetooth service.

config MBS_BLUETOOTH_ADV_INT_MIN_MS
	int "Advertising interval min (ms)"
	range 20 10240
	default 1000
	help
	  Minimum advertising interval in milliseconds when advertising is enabled.
	  The value is converted to BLE units (0.625 ms).

config MBS_BLUETOOTH_ADV_INT_MAX_MS
	int "Advertising interval max (ms)"
	range 20 10240
	default 1200
	help
	  Maximum advertising interval in milliseconds when advertising is enabled.
	  Must be greater than or equal to ADV_INT_MIN_MS. The implementation will
	  clamp MAX to MIN if misconfigured.

config MBS_BLUETOOTH_DEFAULT_ENABLED
	bool "Default enabled"
	default y
	help
	  Default enabled state when no persisted settings exist.

config MBS_BLUETOOTH_DEFAULT_PASSKEY_MODE
	int "Default passkey mode (0=random, 1=fixed)"
	range 0 1
	default 0 if $(dt_chosen_enabled,$(DT_CHOSEN_Z_DISPLAY))
	default 1
	help
	  Default passkey mode when no persisted settings exist.
	  0 = random passkey for each pairing attempt.
	  1 = fixed passkey from MBS_BLUETOOTH_DEFAULT_FIXED_PASSKEY.

config MBS_BLUETOOTH_DEFAULT_FIXED_PASSKEY
	int "Default fixed passkey (0-999999)"
	range 0 999999
	default 123456
	help
	  Fixed passkey used when passkey mode is fixed.

config MBS_BLUETOOTH_STATS
	bool "Meshbus Bluetooth statistics"
	depends on MBS_STATS
	depends on MBS_BLUETOOTH_GATT_NOTIFY
	default y
	help
	  Collect GATT notification attempt, delivery, and drop counters through
	  the Zephyr Stats subsystem.

config MBS_BLUETOOTH_SHELL
	bool "Meshbus Bluetooth shell commands"
	depends on MBS_SHELL
	default y
	help
	  Enable shell commands for Meshbus Bluetooth service.

endif # MBS_BLUETOOTH
