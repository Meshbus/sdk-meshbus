menuconfig MBS_CHANNEL
	bool "Meshbus channel management"
	depends on ZBUS
	depends on SETTINGS
	select PSA_CRYPTO
	select PSA_WANT_ALG_SHA_256
	default n
	help
	  Enable Meshbus channel management subsystem.
	  - Channel configuration
	  - Channel storage via settings

if MBS_CHANNEL
module = MBS_CHANNEL
module-str = mbs_channel
module-help = Sets log level for Meshbus channel management
source "subsys/logging/Kconfig.template.log_config"

config MBS_CHANNEL_MAX_CHANNELS
	int "Maximum number of channels"
	default 64
	range 1 128
	help
	  Maximum number of channels that can be stored.

config MBS_CHANNEL_SECRET_PREFIX_BYTES
	int "Channel secret prefix bytes"
	default 3
	range 3 5
	help
	  Number of bytes used to build the in-memory channel prefix index.

config MBS_CHANNEL_SHELL
	bool "Channel shell commands"
	depends on MBS_SHELL
	default y
	help
	  Enable shell commands for channel management.

endif # MBS_CHANNEL
