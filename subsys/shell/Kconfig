config MBS_SHELL
	bool "Meshbus shell commands"
	depends on SHELL
	default y
	help
	  Enable shell commands for Meshbus subsystem.
	  Provides commands for radio configuration, status monitoring,
	  and diagnostics under the 'meshbus' command group.
